{
  "name": "site-cristiane-souza",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "npm run build && wrangler pages dev dist",
    "astro": "astro",
    "db:migrate:local": "wrangler d1 migrations apply cristiane-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply cristiane-db --remote",
    "db:seed:local": "wrangler d1 execute cristiane-db --local --file scripts/dados-exemplo.sql",
    "usuario:criar": "node scripts/criar-usuario.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/sitemap": "^3.7.4",
    "@lucide/astro": "^1.67.0",
    "astro": "^5.18.2",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261103.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.157.0"
  },
  "allowScripts": {
    "esbuild@0.27.0": true,
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260114.0": true,
    "workerd@1.20261103.1": true,
    "sharp@0.35.5": true,
    "sharp@0.34.5": true
  }
}
