---
import { FRASE } from '../data/site';

const palavras = FRASE.split(' ');
---

<section class="frase" data-words>
  <p>
    {palavras.map((w) => <span data-w>{w} </span>)}
  </p>
</section>

<style>
  .frase {
    max-width: 1100px;
    width: 100%;
    margin: 0 auto;
    padding: clamp(120px, 18vw, 240px) 24px;
  }
  p {
    margin: 0;
    font-size: clamp(32px, 5.2vw, 68px);
    line-height: 1.12;
    font-weight: 600;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  [data-w] { transition: opacity .35s ease; }
  :global(html[data-fx]) [data-w] { opacity: 0.16; }
  :global(html[data-fx]) [data-w][data-lit] { opacity: 1; }
</style>
