---
import { Image } from 'astro:assets';
import { HERO } from '../data/projetos';
import { SITE } from '../data/site';
---

<section class="hero" data-hero aria-label="Início">
  <Image
    src={HERO.img}
    alt=""
    class="hero-img"
    widths={[828, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    style={`object-position:${HERO.posicao}`}
  />
  <div class="hero-vignette" aria-hidden="true"></div>
  <div class="hero-text">
    <div class="hero-kicker">ARQUITETURA E INTERIORES</div>
    <h1>{SITE.nome}</h1>
    <p>Espaços pensados para quem vai viver neles.</p>
  </div>
  <div class="hero-scroll" aria-hidden="true">
    <span>Role para ver</span>
    <span class="hero-line"></span>
  </div>
</section>

<style>
  .hero {
    --p: 0;
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: var(--dark);
  }
  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(calc(1.18 - var(--p) * 0.18));
    opacity: calc(0.78 - var(--p) * 0.35);
    will-change: transform;
    animation: hero-in 2.2s var(--ease) backwards;
  }
  @keyframes hero-in {
    from { transform: scale(1.26); opacity: 0; }
  }
  .hero-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgba(17, 21, 16, 0.15) 0%, rgba(17, 21, 16, 0.65) 100%);
  }
  .hero-text {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 24px;
    gap: 18px;
    opacity: calc(1 - var(--p) * 1.8);
    transform: translate3d(0, calc(var(--p) * -80px), 0);
  }
  .hero-text > * { animation: rise 1.4s var(--ease) backwards; }
  .hero-text > :nth-child(2) { animation-delay: .12s; }
  .hero-text > :nth-child(3) { animation-delay: .24s; }
  @keyframes rise {
    from { opacity: 0; transform: translate3d(0, 32px, 0); }
  }
  .hero-kicker {
    font-size: 13px;
    letter-spacing: 0.3em;
    color: var(--rosa);
    font-weight: 600;
  }
  h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(56px, 11vw, 168px);
    line-height: 0.92;
    letter-spacing: -0.02em;
    color: var(--bg);
  }
  p {
    margin: 6px 0 0;
    font-size: clamp(18px, 2vw, 24px);
    color: rgba(247, 244, 239, 0.85);
    font-weight: 500;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .hero-scroll {
    position: absolute;
    bottom: 32px;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: rgba(247, 244, 239, 0.7);
    font-size: 12px;
    opacity: calc(1 - var(--p) * 4);
  }
  .hero-line {
    width: 1px;
    height: 36px;
    background: rgba(247, 244, 239, 0.5);
    transform-origin: top;
    animation: line 2.4s var(--ease) infinite;
  }
  @keyframes line {
    0% { transform: scaleY(0); transform-origin: 50% 0%; }
    50% { transform: scaleY(1); transform-origin: 50% 0%; }
    51% { transform: scaleY(1); transform-origin: 50% 100%; }
    100% { transform: scaleY(0); transform-origin: 50% 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-img { transform: none; }
  }
</style>
