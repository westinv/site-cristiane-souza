---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  fotos: ImageMetadata[];
  titulo: string;
}

const { fotos, titulo } = Astro.props;

const grandes = await Promise.all(
  fotos.map((src) => getImage({ src, width: Math.min(src.width, 2000), format: 'webp', quality: 82 })),
);
const urls = grandes.map((g) => g.src);
---

<dialog class="lb" data-lb data-fotos={JSON.stringify(urls)} aria-label={`Fotos — ${titulo}`}>
  <img data-lb-img alt="" />
  <div class="lb-count" data-lb-count aria-live="polite"></div>
  <button type="button" class="lb-btn lb-prev" data-lb-prev aria-label="Foto anterior">‹</button>
  <button type="button" class="lb-btn lb-next" data-lb-next aria-label="Próxima foto">›</button>
  <button type="button" class="lb-close" data-lb-close aria-label="Fechar">×</button>
</dialog>

<style>
  .lb {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    border: none;
    background: rgba(10, 12, 10, 0.96);
    padding: clamp(16px, 5vw, 72px);
    color: var(--bg);
    overscroll-behavior: contain;
  }
  .lb[open] {
    display: flex;
    align-items: center;
    justify-content: center;
    animation: lb-in .4s var(--ease);
  }
  .lb::backdrop { background: transparent; }
  @keyframes lb-in { from { opacity: 0; } }
  img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: var(--r-lightbox);
    transition: opacity .25s ease;
  }
  img[data-loading] { opacity: 0.35; }
  .lb-count {
    position: absolute;
    top: 20px;
    left: 0;
    right: 0;
    text-align: center;
    color: rgba(247, 244, 239, 0.7);
    font-size: 13px;
    pointer-events: none;
  }
  .lb-btn, .lb-close {
    position: absolute;
    border: none;
    border-radius: 50%;
    background: rgba(247, 244, 239, 0.14);
    color: var(--bg);
    cursor: pointer;
    transition: background .25s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }
  .lb-btn:hover, .lb-close:hover { background: rgba(247, 244, 239, 0.26); }
  .lb-btn {
    top: 50%;
    transform: translateY(-50%);
    width: 52px;
    height: 52px;
    font-size: 24px;
  }
  .lb-prev { left: 16px; }
  .lb-next { right: 16px; }
  .lb-close { top: 14px; right: 16px; width: 40px; height: 40px; font-size: 20px; }
</style>

<script>
  const lb = document.querySelector<HTMLDialogElement>('[data-lb]');
  if (lb) {
    const fotos: string[] = JSON.parse(lb.dataset.fotos ?? '[]');
    const img = lb.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const count = lb.querySelector<HTMLElement>('[data-lb-count]')!;
    let i = 0;

    const show = (n: number) => {
      i = (n + fotos.length) % fotos.length;
      img.setAttribute('data-loading', '');
      img.onload = () => img.removeAttribute('data-loading');
      img.src = fotos[i];
      count.textContent = `${i + 1} de ${fotos.length}`;
      const next = new Image();
      next.src = fotos[(i + 1) % fotos.length];
    };

    const open = (n: number) => {
      show(n);
      lb.showModal();
      document.documentElement.style.overflow = 'hidden';
    };

    lb.addEventListener('close', () => { document.documentElement.style.overflow = ''; });

    document.querySelectorAll<HTMLElement>('[data-lb-open]').forEach((el) => {
      el.addEventListener('click', () => open(Number(el.dataset.lbOpen)));
    });

    lb.querySelector('[data-lb-prev]')!.addEventListener('click', (e) => { e.stopPropagation(); show(i - 1); });
    lb.querySelector('[data-lb-next]')!.addEventListener('click', (e) => { e.stopPropagation(); show(i + 1); });
    lb.querySelector('[data-lb-close]')!.addEventListener('click', () => lb.close());
    lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
    lb.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(i + 1);
      if (e.key === 'ArrowLeft') show(i - 1);
    });

    let x0: number | null = null;
    lb.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    lb.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) show(i + (dx < 0 ? 1 : -1));
      x0 = null;
    });
  }
</script>
