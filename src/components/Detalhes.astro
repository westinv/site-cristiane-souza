---
import { Image } from 'astro:assets';
import { DETALHES } from '../data/projetos';
---

<section class="hz" data-hz aria-labelledby="detalhes-titulo">
  <div class="hz-sticky">
    <div class="hz-head">
      <h2 id="detalhes-titulo">Os detalhes<br /><span class="serif-accent">fazem o espaço.</span></h2>
    </div>
    <div class="hz-track" data-track>
      {
        DETALHES.map((d) => (
          <figure>
            <div class="hz-img">
              <Image src={d.img} alt={`Detalhe — ${d.nome}`} widths={[480, 900]} sizes="(max-width: 760px) 80vw, 450px" />
            </div>
            <figcaption>{d.nome}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hz {
    position: relative;
    height: 320vh;
    background: var(--dark);
    color: var(--bg);
  }
  .hz-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 40px;
  }
  .hz-head {
    max-width: 1100px;
    width: 100%;
    margin: 0 auto;
    padding: 52px 24px 0;
  }
  h2 {
    margin: 0;
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.02;
  }
  h2 .serif-accent { color: var(--salmao); }
  .hz-track {
    display: flex;
    gap: 20px;
    padding: 0 max(24px, calc((100vw - 1100px) / 2 + 24px));
    width: max-content;
    will-change: transform;
  }
  figure {
    margin: 0;
    flex: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .hz-img {
    height: min(58vh, 560px);
    aspect-ratio: 4 / 5;
    border-radius: var(--r-gallery);
    overflow: hidden;
    background: #222820;
  }
  .hz-img img { width: 100%; height: 100%; object-fit: cover; }
  figcaption { font-size: 13px; color: rgba(247, 244, 239, 0.6); }

  @media (prefers-reduced-motion: reduce) {
    .hz { height: auto; padding: 100px 0; }
    .hz-sticky { position: static; height: auto; overflow: visible; }
    .hz-track { width: auto; overflow-x: auto; scroll-snap-type: x mandatory; }
    figure { scroll-snap-align: center; }
  }
</style>
