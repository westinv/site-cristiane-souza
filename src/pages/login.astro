---
import { Image } from 'astro:assets';
import App from '../layouts/App.astro';
import logoMark from '../assets/logo-mark.png';
import { autenticar, criarSessao } from '../lib/auth';

export const prerender = false;

let erro = '';
let email = '';

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  email = String(fd.get('email') ?? '').trim().slice(0, 200);
  const senha = String(fd.get('senha') ?? '').slice(0, 500);
  if (!email || !senha) {
    erro = 'Informe email e senha.';
  } else {
    const db = Astro.locals.runtime.env.DB;
    const usuario = await autenticar(db, email, senha);
    if (usuario) {
      await criarSessao(db, Astro.cookies, usuario.id, Astro.url.protocol === 'https:');
      return Astro.redirect('/app', 303);
    }
    erro = 'Email ou senha inválidos.';
  }
  Astro.response.status = 400;
}
---

<App title="Entrar" solo>
  <div class="login">
    <form method="post" class="card" novalidate>
      <div style="display:flex;align-items:center;gap:10px">
        <Image src={logoMark} alt="" height={88} style="height:44px;width:auto" />
        <span class="sb-name" style="font-size:24px">Cristiane Souza</span>
      </div>
      <div>
        <h1>Entrar</h1>
        <p class="sub">Acesse a gestão do seu estúdio</p>
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" class="input" type="email" autocomplete="username" value={email} autofocus={!email} />
      </div>
      <div class="field">
        <label for="senha">Senha</label>
        <input id="senha" name="senha" class="input" type="password" autocomplete="current-password" autofocus={!!email} />
      </div>
      {erro && <div class="erro" role="alert">{erro}</div>}
      <button type="submit" class="btn btn-primary btn-block">Entrar</button>
      <a href="/" class="voltar" style="align-self:center">‹ Voltar ao site</a>
    </form>
  </div>
</App>
