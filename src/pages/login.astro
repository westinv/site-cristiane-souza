---
import Base from '../layouts/Base.astro';
---

<Base title="Área restrita" noindex>
  <section class="restrita">
    <span data-rv class="kicker">Área restrita</span>
    <h1 data-rv>Em breve<br /><span class="serif-accent">por aqui.</span></h1>
    <p data-rv>
      Este espaço vai reunir contratos, documentos e o andamento de cada projeto. Enquanto isso, fale com a gente pelo contato.
    </p>
    <div data-rv class="btns">
      <a href="/contato" class="pill pill--dark">Entrar em contato</a>
      <a href="/" class="voltar">Voltar ao início ›</a>
    </div>
  </section>
</Base>

<style>
  .restrita {
    max-width: 820px;
    width: 100%;
    margin: 0 auto;
    padding: clamp(160px, 18vw, 220px) 24px clamp(100px, 12vw, 160px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
  }
  .kicker { color: var(--terracota); }
  h1 {
    margin: 0;
    font-size: clamp(48px, 8vw, 104px);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.96;
  }
  h1 .serif-accent { color: var(--terracota); }
  p { margin: 0; font-size: clamp(18px, 1.6vw, 21px); line-height: 1.55; color: var(--gray-1); max-width: 560px; }
  .btns { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; align-items: center; margin-top: 8px; }
  .pill { padding: 15px 28px; font-size: 16px; }
  .voltar { text-decoration: none; font-weight: 600; font-size: 16px; padding: 15px 12px; }
</style>
